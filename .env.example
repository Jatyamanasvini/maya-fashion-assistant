# ==========================================
# MAYA - AI Personal Fashion Assistant Configuration
# ==========================================

# Database Configuration (MySQL)
DATABASE_URL=jdbc:mysql://localhost:3306/maya_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DATABASE_USERNAME=root
DATABASE_PASSWORD=your_mysql_password_here

# Security / JWT Configuration (Min 256-bit base64 / hex secret)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Server Port
SERVER_PORT=8080

# Image Storage Configuration (Local protected file storage directory)
IMAGE_STORAGE_PATH=./uploads/images

# Multimodal AI Provider Configuration
# Supported providers: OPENAI, GEMINI, MOCK (for testing/offline development)
AI_PROVIDER=OPENAI
AI_API_KEY=your_ai_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_VISION_MODEL=gpt-4o-mini

# Image Generation Configuration
# Provider supported: OPENAI (or MOCK for no visualization).
# Model examples: "gpt-image-1" (returns inline base64) or "dall-e-3" (returns a URL).
# The backend handles both response shapes.
IMAGE_GENERATION_PROVIDER=OPENAI
IMAGE_GENERATION_MODEL=gpt-image-1
IMAGE_GENERATION_API_KEY=your_image_generation_api_key_here

# Weather API Configuration (Default uses Open-Meteo free API without requiring an API key)
WEATHER_PROVIDER=OPEN_METEO
WEATHER_BASE_URL=https://api.open-meteo.com/v1
WEATHER_API_KEY=optional_if_provider_requires_key
WEATHER_DEFAULT_CITY=New York
WEATHER_DEFAULT_LAT=40.7128
WEATHER_DEFAULT_LON=-74.0060

# Frontend Configuration
PORT=3000
REACT_APP_API_BASE_URL=http://localhost:8080/api
